[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build log
*.log

# NuGet Packages
packages/
*.nupkg
!*.nupkg.metadata
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Mac files
.DS_Store

# Rider
.idea/

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Misc
*.pidb
*.svclog
*.scc
*.tmp
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings

# Sensitive files - NEVER commit these
DATABASE_CONNECTION_INFO.md
